PROJECT_NAME="Digital Material Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="digital_learning_material_super_secret_jwt_key_graduation_thesis_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------
# DATABASE CONFIGURATION OPTIONS (PostgreSQL / SQLite)
# ----------------------------------------------------------------------

# Option 1: Full PostgreSQL URL (recommended for Production / Docker / Cloud)
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/digital_materials"

# Option 2: Individual PostgreSQL Connection Parameters
# POSTGRES_SERVER="localhost"
# POSTGRES_PORT="5432"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="your_password"
# POSTGRES_DB="digital_materials"

# Option 3: Local SQLite fallback (Default for local development)
DATABASE_URL="sqlite:///./digital_materials.db"

# ----------------------------------------------------------------------
# FILE STORAGE CONFIGURATION ('local' or 'cloudinary')
# ----------------------------------------------------------------------
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./uploads"

# Cloudinary Credentials (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
